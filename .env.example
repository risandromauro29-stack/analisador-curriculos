# Copie para .env (uso local) ou configure como variáveis de ambiente no
# painel do Render/Railway. Nunca commite o .env de verdade.

# Chave usada para assinar a sessão de login. Gere uma só vez com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Se não definir, a sessão de todo mundo cai a cada reinício da aplicação.
SECRET_KEY=

# Banco de dados. Sem definir, usa um arquivo SQLite local — ok para testar,
# mas em PaaS com disco efêmero (Render free, por ex.) os dados somem a cada
# deploy. Em produção, aponte para um Postgres gerenciado (Render/Railway/
# Neon/Supabase têm planos gratuitos):
#   postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# Primeiro administrador — criado automaticamente na primeira inicialização
# se ainda não existir nenhum usuário no banco. Depois disso, novos usuários
# são criados pela própria tela /admin/usuarios.
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=
